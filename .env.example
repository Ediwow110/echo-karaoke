# Local development values. Copy this file to .env.local, which git ignores.
# `cp server/.env.neon .env.local` already provides the database and auth values
# for this machine. Production values live in the Vercel project environment; see
# docs/deployment/hosted-setup.md.

# Room operations use the pooled service_role URL. Better Auth needs its own
# direct URL because it cannot run over a pooled connection.
DATABASE_URL=
AUTH_DATABASE_URL=

# Preview only. Point these at a disposable Neon branch, never at the
# production database. The function selects them when VERCEL_ENV=preview.
PREVIEW_DATABASE_URL=
PREVIEW_AUTH_DATABASE_URL=

# Owner-direct URL. Migrations and CI only; the function never reads it.
NEON_DATABASE_URL=

# Signing secret for guest JWTs: at least 32 random characters.
BETTER_AUTH_SECRET=

# Optional auth origin. Derived from VERCEL_URL when unset; set it only for a
# fixed custom domain.
BETTER_AUTH_URL=

# Comma-separated bare https origins, no paths and no trailing slashes.
ALLOWED_ORIGINS=

# Optional abuse limits; these are the defaults.
ROOM_MEMBER_LIMIT=50
ANON_SIGNIN_LIMIT_PER_HOUR=120

# Optional YouTube Data API key. Without it, search and karaoke picks report
# that they are not configured and the search panel offers a manual
# YouTube-link fallback. Server-side only: a VITE_ prefixed copy would enter
# the browser bundle.
YOUTUBE_API_KEY=

# YouTube's current quota model: search.list has its own 100-call/day bucket
# (1 unit each), shared by user searches and the karaoke strip. The strip
# caches a pool for twelve hours and serves a random eight per screen; both
# budgets together must stay within 100.
YOUTUBE_DAILY_SEARCH_BUDGET=90
YOUTUBE_DAILY_POPULAR_BUDGET=6

# oEmbed metadata is quota-free, but it is still bounded so one room or one
# deployment cannot turn the add button into an unbounded outbound amplifier.
YOUTUBE_DAILY_METADATA_BUDGET=5000
YOUTUBE_ROOM_METADATA_BUDGET=500

# Optional. Only needed when the API is not same-origin with the app.
VITE_API_BASE_URL=

# Optional. Tunnel host names the Vite dev server should accept, for example
# .trycloudflare.com.
VITE_DEV_ALLOWED_HOSTS=
