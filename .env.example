# Local development values. Copy this file to .env.local, which git ignores.
# `cp server/.env.neon .env.local` already provides the database and auth values
# for this machine. Production values live in the Vercel project environment; see
# docs/deployment/hosted-setup.md.

# Room operations use the pooled service_role URL. Better Auth needs its own
# direct URL because it cannot run over a pooled connection.
DATABASE_URL=
AUTH_DATABASE_URL=

# Owner-direct URL. Migrations and CI only; the function never reads it.
NEON_DATABASE_URL=

# Signing secret for guest JWTs: at least 32 random characters.
BETTER_AUTH_SECRET=

# Optional auth origin. Derived from VERCEL_URL when unset; set it only for a
# fixed custom domain.
BETTER_AUTH_URL=

# Comma-separated bare https origins, no paths and no trailing slashes.
ALLOWED_ORIGINS=

# Optional abuse limits; these are the defaults.
ROOM_MEMBER_LIMIT=50
ANON_SIGNIN_LIMIT_PER_HOUR=120

# Optional YouTube Data API key. Without it, search and chart suggestions answer
# that they are not configured and guests paste YouTube links instead. Server-side
# only: a VITE_ prefixed copy would be baked into the browser bundle.
YOUTUBE_API_KEY=

# Daily upstream calls allowed across all rooms. Each search.list call costs 100
# units of the project's 10,000 per day, so the search budget is the one to watch.
YOUTUBE_DAILY_SEARCH_BUDGET=90
YOUTUBE_DAILY_POPULAR_BUDGET=200

# Optional. Only needed when the API is not same-origin with the app.
VITE_API_BASE_URL=

# Optional. Tunnel host names the Vite dev server should accept, for example
# .trycloudflare.com.
VITE_DEV_ALLOWED_HOSTS=
