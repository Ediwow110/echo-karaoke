# Server-side Edge Function secrets. Never expose these with a VITE_ prefix.
# Optional YouTube Data API v3 key. Without it search is reported as unavailable
# and the paste-link fallback remains usable.
YOUTUBE_API_KEY=

# Maximum searches allowed across all rooms per Pacific day. YouTube's
# default search.list bucket allows 100 calls per day, so 90 leaves 10 calls
# of headroom. Daily quotas reset at midnight Pacific.
YOUTUBE_DAILY_SEARCH_BUDGET=90

# Maximum most-popular chart refreshes across all rooms per Pacific day.
# Each refresh is one videos.list call from the shared 10,000-unit pool.
YOUTUBE_DAILY_POPULAR_BUDGET=200

# Comma-separated browser origins allowed to call the Edge Functions.
# Set this to the deployed app origin in production. An empty list reflects
# the request origin, which is convenient locally but too permissive publicly.
ALLOWED_ORIGINS=
